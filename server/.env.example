PORT=3000
HOST=127.0.0.1
DB_PATH=/var/lib/link-profile/views.sqlite
IP_SALT=replace-with-long-random-string
# CISTiers просит указывать в User-Agent проект и контакт: Проект/Версия (+URL; контакт)
CISTIERS_USER_AGENT="MySite/1.0 (+https://example.com; contact@example.com)"
# Minecraft-сервер для /api/server (по умолчанию cisprac.xyz), можно с портом: host:25566
# MC_SERVER_ADDRESS=cisprac.xyz
# Discord-профиль для /api/discord/* (по умолчанию ID из server/discord.js)
# DISCORD_USER_ID=835533218869936168
